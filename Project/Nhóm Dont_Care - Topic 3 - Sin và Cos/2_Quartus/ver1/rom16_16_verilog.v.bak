module rom16x16 (
    input  wire [3:0]  addr,
    output reg  [15:0] data
);

always @(*) begin
    case (addr)
        4'b0000: data = 16'b0000_0000_0000_0000;
        4'b0001: data = 16'b0000_0000_0000_0001;
        4'b0010: data = 16'b0000_0000_0000_0010;
        4'b0011: data = 16'b0000_0000_0000_0011;
        4'b0100: data = 16'b0000_0000_0000_0100;
        4'b0101: data = 16'b0000_0000_0000_0101;
        4'b0110: data = 16'b0000_0000_0000_0110;
        4'b0111: data = 16'b0000_0000_0000_0111;
        4'b1000: data = 16'b0000_0000_0000_1000;
        4'b1001: data = 16'b0000_0000_0000_1001;
        4'b1010: data = 16'b0000_0000_0000_1010;
        4'b1011: data = 16'b0000_0000_0000_1011;
        4'b1100: data = 16'b0000_0000_0000_1100;
        4'b1101: data = 16'b0000_0000_0000_1101;
        4'b1110: data = 16'b0000_0000_0000_1110;
        4'b1111: data = 16'b0000_0000_0000_1111;
        default: data = 16'b0000_0000_0000_0000;
    endcase
end

endmodule
