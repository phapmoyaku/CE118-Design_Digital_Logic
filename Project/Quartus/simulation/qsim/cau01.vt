initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module ver1_debug_vlg_vec_tst();
// constants                                           
// general purpose registers
reg Clk;
reg Start;
reg [15:0] Z;
// wires                                               
wire [15:0] Cos;
wire is_14;
wire Q0;
wire Q1;
wire Q2;
wire Q3;
wire [15:0] Sin;
wire [15:0] TestB1;
wire [15:0] TestB2;
wire [3:0] TestB3;
wire [15:0] TestB4;
wire [15:0] TestB5;
wire [15:0] TestB6;
wire [15:0] TestR1;
wire [15:0] TestR2;
wire [15:0] TestR3;

wire sampler;                             

// assign statements (if any)                          
ver1_debug i1 (
// port map - connection between master ports and signals/registers   
	.Clk(Clk),
	.Cos(Cos),
	.is_14(is_14),
	.Q0(Q0),
	.Q1(Q1),
	.Q2(Q2),
	.Q3(Q3),
	.Sin(Sin),
	.Start(Start),
	.TestB1(TestB1),
	.TestB2(TestB2),
	.TestB3(TestB3),
	.TestB4(TestB4),
	.TestB5(TestB5),
	.TestB6(TestB6),
	.TestR1(TestR1),
	.TestR2(TestR2),
	.TestR3(TestR3),
	.Z(Z)
);

// Clk
always
begin
	Clk = 1'b0;
	Clk = #1000 1'b1;
	#1000;
end 

// Start
initial
begin
	Start = 1'b0;
	Start = #20000 1'b1;
	Start = #30000 1'b0;
	Start = #290000 1'b1;
	Start = #30000 1'b0;
	Start = #580000 1'b1;
	Start = #20000 1'b0;
end 
// Z[ 15 ]
initial
begin
	Z[15] = 1'b0;
end 
// Z[ 14 ]
initial
begin
	Z[14] = 1'b0;
end 
// Z[ 13 ]
initial
begin
	Z[13] = 1'b0;
end 
// Z[ 12 ]
initial
begin
	Z[12] = 1'b0;
	Z[12] = #20000 1'b1;
	Z[12] = #200000 1'b0;
end 
// Z[ 11 ]
initial
begin
	Z[11] = 1'b0;
	Z[11] = #20000 1'b1;
	Z[11] = #200000 1'b0;
end 
