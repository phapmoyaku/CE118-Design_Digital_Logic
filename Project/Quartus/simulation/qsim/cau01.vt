	Z[0] = 1'b0;
	Z[0] = #20000 1'b1;
	Z[0] = #200000 1'b0;
end 

ver1_debug_vlg_sample_tst tb_sample (
	.Clk(Clk),
	.Start(Start),
	.Z(Z),
	.sampler_tx(sampler)
);

ver1_debug_vlg_check_tst tb_out(
	.Cos(Cos),
	.is_14(is_14),
	.Q0(Q0),
	.Q1(Q1),
	.Q2(Q2),
	.Q3(Q3),
	.Sin(Sin),
	.TestB1(TestB1),
	.TestB2(TestB2),
	.TestB3(TestB3),
	.TestB4(TestB4),
	.TestB5(TestB5),
	.TestB6(TestB6),
	.TestR1(TestR1),
	.TestR2(TestR2),
	.TestR3(TestR3),
	.sampler_rx(sampler)
);
endmodule

