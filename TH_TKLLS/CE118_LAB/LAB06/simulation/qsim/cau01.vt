module cau01_vlg_vec_tst();
// constants                                           
// general purpose registers
reg Clk;
reg [31:0] Inst;
// wires                                               
wire [31:0] Reg1;
wire [31:0] Reg2;
wire [31:0] Reg3;
wire [31:0] Reg4;
wire [31:0] Reg5;

wire sampler;                             

// assign statements (if any)                          
cau01 i1 (
// port map - connection between master ports and signals/registers   
	.Clk(Clk),
	.Inst(Inst),
	.Reg1(Reg1),
	.Reg2(Reg2),
	.Reg3(Reg3),
	.Reg4(Reg4),
	.Reg5(Reg5)
);

// Clk
initial
begin
	Clk = 1'b1;
	Clk = #20000 1'b0;
	# 20000;
	repeat(24)
	begin
		Clk = 1'b1;
		Clk = #20000 1'b0;
		# 20000;
	end
end 
// Inst[ 31 ]
initial
begin
	Inst[31] = 1'b0;
	Inst[31] = #300000 1'b1;
	Inst[31] = #240000 1'b0;
