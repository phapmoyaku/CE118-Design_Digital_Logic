// generate trigger
always @(Reg1_expected or Reg1 or Reg2_expected or Reg2 or Reg3_expected or Reg3 or Reg4_expected or Reg4 or Reg5_expected or Reg5)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected Reg1 = %b | expected Reg2 = %b | expected Reg3 = %b | expected Reg4 = %b | expected Reg5 = %b | ",Reg1_expected_prev,Reg2_expected_prev,Reg3_expected_prev,Reg4_expected_prev,Reg5_expected_prev);
	$display("| real Reg1 = %b | real Reg2 = %b | real Reg3 = %b | real Reg4 = %b | real Reg5 = %b | ",Reg1_prev,Reg2_prev,Reg3_prev,Reg4_prev,Reg5_prev);
`endif
	if (
		( Reg1_expected_prev[0] !== 1'bx ) && ( Reg1_prev[0] !== Reg1_expected_prev[0] )
		&& ((Reg1_expected_prev[0] !== last_Reg1_exp[0]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Reg1[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Reg1_expected_prev);
		$display ("     Real value = %b", Reg1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Reg1_exp[0] = Reg1_expected_prev[0];
	end
	if (
		( Reg1_expected_prev[1] !== 1'bx ) && ( Reg1_prev[1] !== Reg1_expected_prev[1] )
		&& ((Reg1_expected_prev[1] !== last_Reg1_exp[1]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Reg1[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Reg1_expected_prev);
		$display ("     Real value = %b", Reg1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Reg1_exp[1] = Reg1_expected_prev[1];
	end
	if (
		( Reg1_expected_prev[2] !== 1'bx ) && ( Reg1_prev[2] !== Reg1_expected_prev[2] )
		&& ((Reg1_expected_prev[2] !== last_Reg1_exp[2]) ||
			on_first_change[1])
	)
