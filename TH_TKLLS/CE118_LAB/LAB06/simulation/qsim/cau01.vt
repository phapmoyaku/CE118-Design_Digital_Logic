`timescale 1 ps/ 1 ps
module cau01_vlg_sample_tst(
	Clk,
	Inst,
	sampler_tx
);
input  Clk;
input [31:0] Inst;
output sampler_tx;

reg sample;
time current_time;
always @(Clk or Inst)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

